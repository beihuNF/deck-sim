// Static game assets and up to 4-player room coordination.
{
  "name": "sts2-web",
  "compatibility_date": "2026-09-01",
  "main": "./packages/server/src/index.ts",
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "WebRoom" }, { "name": "AUTH", "class_name": "SteamAuth" }] },
  "migrations": [{ "tag": "web-rooms-v1", "new_sqlite_classes": ["WebRoom"] }, { "tag": "steam-auth-v1", "new_sqlite_classes": ["SteamAuth"] }],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/api/multiplayer/*", "/api/auth/*", "/r/*", "/room/*"],
    "directory": "./packages/app/dist",
    // a missing file is a 404, not the page: scene and shader loading tell "not there" by it, and the service worker
    // would otherwise cache the page as that asset
    "not_found_handling": "none"
  },
  // Keep this origin stable: players' saves live in their browsers. Cloudflare manages DNS and TLS for the custom domain.
  // routes 暂时注释，将 sts2.136521.xyz 转移至 GitHub Pages 测试
  // "routes": [
  //   { "pattern": "sts2.136521.xyz", "custom_domain": true }
  // ],
  "observability": {
    "enabled": true
  },
  "workers_dev": true
}
