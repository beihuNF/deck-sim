# Cloudflare (wrangler.jsonc) response headers; other hosts ignore this file.

# Global security headers
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Entry points: must be revalidated so players immediately receive updates
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Hashed JS bundle and Web Worker chunks
/js/*
  Cache-Control: public, max-age=2592000, immutable
  Access-Control-Allow-Origin: *

# Cloudflare compresses by content type, not application/octet-stream or missing types.
# Binary skeletons get a binary protobuf type on Cloudflare's compression list.
# Text formats like .atlas and .gdshader get text/plain; charset=utf-8.
/js/*.bin
  Content-Type: application/x-protobuf
/assets/*.atlas
  Content-Type: text/plain; charset=utf-8
/assets/*.gdshader
  Content-Type: text/plain; charset=utf-8
/assets/*.skel
  Content-Type: application/x-protobuf
  Cache-Control: public, max-age=2592000, immutable

# Default assets cache (i18n, scenes, atlases, shaders, models): 30 days with stale revalidation
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

# Immutable font files
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Images and Audio
/assets/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *
/assets/audio/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

